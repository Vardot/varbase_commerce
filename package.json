{
  "name": "varbase_commerce",
  "license": "GPL-2.0-or-later",
  "private": true,
  "description": "Provides a starting point for Varbase merchandise section and the products catalog.",
  "engines": {
    "yarn": ">= 4.9.3",
    "node": ">= 20.0"
  },
  "keywords": [
    "Drupal",
    "Varbase",
    "JSON API",
    "Open API"
  ],
  "author": "Vardot",
  "packageManager": "yarn@4.9.3",
  "scripts": {
    "phpcs": "phpcs --standard=./.phpcs.xml .",
    "phpcbf": "phpcbf --standard=./.phpcs.xml .",
    "lint:yaml": "node ./node_modules/eslint/bin/eslint.js --config=.eslintrc.json --ext .yml .",
    "spellcheck": "cspell lint ."
  },
  "devDependencies": {
    "cspell": "^9.2.1",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-yml": "^1.15.0",
    "prettier": "^3.6.2"
  }
}
